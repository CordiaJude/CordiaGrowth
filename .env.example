# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---------------------------------------------------------------
# Local dev: values printed by `pnpm db:start` (`supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS; used by background jobs. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

APP_URL=http://localhost:3000

# --- Encryption at rest (OAuth tokens, CMS credentials) -----------------------
# Comma-separated "version:base64key" pairs (32-byte keys). Highest version
# encrypts; older versions stay listed until data is re-encrypted.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Background jobs ----------------------------------------------------------
# auto: use Trigger.dev when TRIGGER_SECRET_KEY is set, otherwise run inline
#       inside the Next.js process (local dev only; not for production).
JOB_RUNNER=auto
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- AI providers (Phase 1: AI visibility) ------------------------------------
# A provider without a key is skipped. Claude is also used to parse answers and
# suggest prompts, so ANTHROPIC_API_KEY is required for runs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides (defaults live in src/config/ai.ts).
# VISIBILITY_MODEL_ANTHROPIC=claude-opus-5-5
# VISIBILITY_MODEL_OPENAI=gpt-6.1-sol
# VISIBILITY_MODEL_GEMINI=gemini-3.8-flash
# VISIBILITY_MODEL_PERPLEXITY=perplexity/sonar
# VISIBILITY_PARSER_MODEL=claude-opus-5-5
# VISIBILITY_PARSER_EFFORT=low
# PROMPT_SUGGESTER_MODEL=claude-opus-5-5
# VISIBILITY_CONCURRENCY=4

# --- Scheduled runs -----------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/visibility.
# Generate: openssl rand -hex 32
CRON_SECRET=
